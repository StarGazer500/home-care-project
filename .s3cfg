# S3cmd configuration for Contabo Object Storage
# Copy this to ~/.s3cfg and fill in your credentials

[default]
# Get these from your Contabo Object Storage panel
access_key = a94f80bddaeff4cc27a8368e0a05538b
secret_key = 56e106fa40ba21116a491664339aef34

# Contabo EU endpoint
host_base = eu2.contabostorage.com
host_bucket = eu2.contabostorage.com

# SSL/TLS settings
use_https = True
check_ssl_certificate = False
check_ssl_hostname = False

# Bucket settings
bucket_location = us-east-1
region = us-east-1

# Signature version (AWS v4)
signature_v2 = False

# Performance settings
multipart_chunk_size_mb = 15
multipart_max_chunks = 10000

# Display settings
human_readable_sizes = True
